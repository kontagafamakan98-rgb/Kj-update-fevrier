    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "playtest:api": "node scripts/playtest-api-server.mjs",
    "check:test-environment": "node scripts/check-test-environment.js",
    "check:git-branches": "node scripts/check-git-branches.js",
    "lint:workflows": "node scripts/check-workflows-lint.mjs",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:vercel": "node scripts/validate-vercel-json.mjs",
    "check:og-reproducible": "node scripts/check-og-reproducible.js",
    "check:icons": "node scripts/check-generated-icons.js",
    "check:pwa": "node scripts/check-pwa-manifest.js",
    "report:bundle": "node scripts/bundle-size-report.js",
    "predeploy": "npm run validate:vercel",
    "prepare": "git config core.hooksPath .githooks || echo pre-vol de push non arme, voir AGENTS.md"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
