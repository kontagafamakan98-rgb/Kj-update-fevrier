    "@lhci/cli": "^0.15.1",
    "@lhci/utils": "0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.6.1",
    "chrome-launcher": "1.2.2",
    "esbuild": "^0.25.3",
    "jsdom": "^30.1.3",
    "lighthouse": "13.5.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
