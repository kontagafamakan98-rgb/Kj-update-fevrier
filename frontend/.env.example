# ============================================================
# Kojo Frontend — Variables d'environnement (Vite)
# Copier en .env.local pour le développement.
# En production Vercel : configurer dans Project Settings → Environment Variables
# ============================================================

# URL du backend Render (sans slash final).
# Si absent, le frontend se rabat sur l'URL Render codée en dur dans api.js.
VITE_API_URL=https://kojo-backend-03az.onrender.com/api

# Variante alternative acceptée (si vous préférez ce nom)
# VITE_BACKEND_URL=https://kojo-backend-03az.onrender.com
