.pnpm-store/

# Build outputs
build/
dist/
frontend/build/
frontend/dist/
coverage/
.cache/
.next/
out/

# Logs — `*.log.*` couvre les rotations, que `*.log` laissait passer : le
# suffixe numérique faisait échapper le fichier. Le RotatingFileHandler de
# backend/kojo_settings.py produit jusqu'à kojo_backend.log.5 (maxBytes=10 Mo,
# backupCount=5), soit ~50 Mo. Depuis le 19/09/2026 son chemin est ABSOLU et
# hors du dépôt (répertoire temporaire, `KOJO_LOG_FILE`) : ces règles ne sont
# plus qu'un filet contre un `git add -A` distrait.
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
venv/
.venv/

# Env files
*.env
*.env.*
!frontend/.env.example
!backend/.env.example

# Tooling / deployment
.vercel/
*.tsbuildinfo

# Freebuff (état interne de l'outil)
.freebuff/

# Archives / binaries
*.zip
*.tar
*.tar.gz
*.tgz
*.pack
*.deb
*.dylib
*.pem

# MongoDB portable local (validation hors Docker)
.mongo-tmp/

# Notebook / misc
.ipynb_checkpoints/
chainlit.md
.chainlit/
.ac

# Backup / snapshot files left by past fix sessions
*.backup
*.before-*
*.orig
*.old
*_backup.*

# One-off report/summary files generated by past AI fix sessions
kojo-pack-*-report.txt
kojo-jobs-*-report.txt
*-report.txt

# Ad hoc audit/test scripts dropped at the repo root (real tests belong in
# frontend/src/**/*.test.js or a proper backend tests/ suite, not loose here)
/*_test.py
/*_audit*.py
/audit_*.py

# Mesures du rapport de taille du bundle (job CI `bundle-size-report`) :
# frontend/.bundle-size/ reçoit les mesures et le corps du commentaire à
# chaque run. Jamais versionné — c'est un transport, pas une source.
.bundle-size/

# Harnais, sondes et sorties d'outils des sessions d'audit/mesure locales.
# Ce ne sont PAS des tests ni des scripts CI : les vrais gardes-fous restent
# suivis (frontend/scripts/check-*.js, frontend/src/utils/__tests__/*.test.js)
# et sont exécutés par .github/workflows/ci.yml.
.tmp-*/
*.tmp.cjs
*.tmp.mjs
# Rapports et cache produits par `lhci autorun` en local.
frontend/lhci-reports/
.lighthouseci/

# Local data dumps / backups that should never live in the repo
mongodb-data/
# Exclut le dossier uploads/ à N'IMPORTE QUEL niveau du repo (pas seulement
# à la racine) - l'ancien pattern "/uploads/" avec le slash de tête n'excluait
# QUE la racine et laissait passer backend/uploads/, qui est le dossier
# réellement utilisé par server.py en prod (contient d'anciennes photos de
# profil utilisateurs committées par erreur).
uploads/
# Fichiers de config personnels — jamais dans le repo
.gitconfig

*_extract/
kojo-emergency-backup*/

