# ============================================================
# Kojo Backend — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs manquantes.
# Ne jamais committer le fichier .env sur Git.
# ============================================================

# --- MongoDB ---
# URI complète de connexion (Atlas ou auto-hébergé)
MONGO_URL=mongodb://localhost:27017
# Nom de la base de données (kojo en prod, kojo_test en test)
DB_NAME=kojo

# --- JWT / Auth ---
# Chaîne aléatoire longue (min 32 caractères). Générer avec :
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# --- App ---
# "production" | "development" | "test"
APP_ENV=development

# URL publique du frontend (sans slash final) — en prod : https://kojoforafrica.cc.cd
FRONTEND_APP_URL=http://localhost:3000
# URL publique du backend Render (sans slash final, optionnel - auto-détecté via RENDER_EXTERNAL_HOSTNAME)
BACKEND_PUBLIC_URL=

# --- Sécurité / CORS ---
# Nom du projet Vercel (ex: kj-update-fevrier). Si défini, restreint le CORS
# aux seuls sous-domaines *.vercel.app de CE projet. Fortement recommandé en prod.
VERCEL_PROJECT_NAME=kj-update-fevrier

# Origines CORS supplémentaires séparées par virgule (optionnel)
CORS_ORIGINS=

# Hôtes de confiance supplémentaires pour TrustedHostMiddleware (optionnel).
# Fly : les motifs *.internal, *.flycast.internal, *.fly.dev sont déjà inclus
# par défaut par build_trusted_hosts() — ne les ajouter ici qu'en surcharge.
TRUSTED_HOSTS=

# Pour désactiver TrustedHostMiddleware (ex: en test, ou en cas de Host
# attendu non couvert par les défauts) :
# DISABLE_TRUSTED_HOST_MIDDLEWARE=true

# --- Session par cookie httpOnly (auth web, protection XSS) ---
# Nom des cookies (défauts : kojo_session / kojo_csrf) — ne pas changer en prod.
# AUTH_COOKIE_NAME=kojo_session
# CSRF_COOKIE_NAME=kojo_csrf
# SameSite : 'none' en prod (frontend Vercel ↔ backend Fly en cross-site,
# exige Secure) ; 'lax' en dev local (même origine localhost).
# AUTH_COOKIE_SAMESITE=none
# Secure : true en prod (HTTPS), false en dev local (HTTP).
# AUTH_COOKIE_SECURE=true

# --- Compte propriétaire (admin) ---
OWNER_EMAIL=
OWNER_INITIAL_PASSWORD=
OWNER_USER_ID=
# Alias legacy (même valeur que OWNER_EMAIL)
FAMAKAN_OWNER_EMAIL=

# --- PayDunya (paiements) ---
# Mode : "test" pour sandbox, "live" pour production
PAYDUNYA_MODE=test
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_STORE_NAME=KOJO
# Taux de commission Kojo en décimal (ex: 0.10 = 10%)
PAYMENT_COMMISSION_RATE=0.10

# --- Séquestre à deux temps (kojo_job_completion) ---
# Délai laissé au client pour VALIDER la fin de mission déclarée par le
# travailleur. Passé ce délai, le séquestre est libéré automatiquement — sans
# quoi un client injoignable laisserait le travailleur impayé indéfiniment.
# 1 jour minimum (le serveur refuse de démarrer en dessous).
COMPLETION_AUTO_RELEASE_DAYS=7
# Cadence du balayage qui libère les échéances passées, en minutes (1..1440).
COMPLETION_SWEEP_INTERVAL_MINUTES=60

# Récompense de parrainage (FCFA) créditée quand le filleul termine sa
# PREMIÈRE mission : une part au parrain, une part au filleul.
REFERRAL_SPONSOR_REWARD=500
REFERRAL_FILLEUL_REWARD=500

# Bonus de BIENVENUE (FCFA) crédité dès l'inscription quand le code de
# parrainage est appliqué : une part au parrain, une part à l'invité.
REFERRAL_WELCOME_SPONSOR_REWARD=250
REFERRAL_WELCOME_FILLEUL_REWARD=250

# --- Email ---
# Fournisseur actif : "brevo" | "resend" | "gmail" | "none"
# Il décide de TOUS les envois (code OTP, reçus, alertes owner) : voir
# kojo_email.send_email_via_active_provider. C'est aussi lui que juge GET
# /monitor/email, avec son expéditeur (503 nommé quand la clé est refusée, le
# transport coupé ou l'expéditeur inutilisable).
EMAIL_PROVIDER=brevo

# Brevo (Sendinblue) — recommandé pour l'Afrique de l'Ouest
BREVO_API_KEY=
# Expéditeur transactionnel : une adresse SUR LE DOMAINE (SPF/DKIM/DMARC
# publiés), jamais une adresse Gmail — Brevo envoie sous l'identité déclarée
# ici, donc SPF/DKIM/DMARC ne s'appliqueraient pas à une adresse Gmail.
BREVO_SENDER_EMAIL=noreply@kojoforafrica.cc.cd
BREVO_SENDER_NAME=KOJO
# Boîte qui reçoit les RÉPONSES : l'adresse d'envoi du domaine n'a pas de
# boîte. Vide = aucun Reply-To (les réponses repartent à l'expéditeur).
BREVO_REPLY_TO_EMAIL=kojoapp98@gmail.com

# Resend (https://resend.com) — alternative à Brevo, API REST (clé `re_…`).
# L'expéditeur doit appartenir à un domaine VÉRIFIÉ chez Resend (SPF/DKIM) ;
# sans domaine vérifié, Resend n'écrit qu'à l'adresse du compte, donc
# `onboarding@resend.dev` (expéditeur de test) ne suffit pas en production.
# Mettre EMAIL_PROVIDER=resend pour l'activer.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=KOJO
# Réponses : même boîte lue que Brevo par défaut. Vide = aucun Reply-To.
RESEND_REPLY_TO_EMAIL=

# Webhook Resend (rebonds, plaintes) : Resend signe ses notifications avec un
# secret Svix créé dans son tableau de bord (Webhooks → Signing Secret). Le
# coller ici tel quel (`whsec_…`) : la signature se vérifie avec la clé
# dérivée de ce secret, jamais avec la chaîne brute.
# Vide = ingestion DÉSACTIVÉE (la route du webhook refuse et le dit) ; le
# backend démarre sans. Une adresse qui rebondit durablement ou qui signale
# nos emails comme spam est alors marquée injoignable et n'est plus écrite.
RESEND_WEBHOOK_SECRET=
# Fenêtre de fraîcheur d'une signature (secondes) : sans borne, une requête
# signée capturée une fois se rejoue à jamais. 300 s = tolérance Svix.
EMAIL_WEBHOOK_TOLERANCE_SECONDS=300
# Rebonds TRANSITOIRES consécutifs avant alerte au propriétaire (la boîte
# existe : on n'écrit pas l'adresse au rebut, on prévient).
EMAIL_SOFT_BOUNCE_ALERT_THRESHOLD=3

# Gmail OAuth2 (alternative)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=KOJO

# Paramètres email communs (optionnel — valeurs par défaut conservées)
PASSWORD_RESET_FROM_EMAIL=
EMAIL_OTP_SECRET=
EMAIL_OTP_EXPIRY_MINUTES=10
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_TOKEN_MINUTES=30

# --- Cloudinary (photos de profil) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- VAPID (notifications push) ---
# Générer les clés avec : python -c "from pywebpush import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key); print(v.public_key)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:kojoapp98@gmail.com

# --- Métriques Prometheus (endpoint /metrics, OPTIONNEL) ---
# Jeton porteur attendu dans `Authorization: Bearer <METRICS_TOKEN>`.
# VIDE = l'endpoint refuse (503 nommée) : les métriques ne sont JAMAIS
# publiques. Générer avec : python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sur Fly : fly secrets set METRICS_TOKEN=… ; collecte : backend/METRIQUES.md.
METRICS_TOKEN=

# --- Sentry (monitoring d'erreurs, OPTIONNEL) ---
# Activé uniquement si SENTRY_DSN est défini (vide = désactivé, no-op).
# Le DSN backend est un SECRET (jamais dans le code client).
# Sur Render : Environment → ajouter SENTRY_DSN → Deploy (voir SENTRY_SETUP_GUIDE.md).
SENTRY_DSN=

# --- Redis (rate-limiter ET bus temps réel, optionnel) ---
# Si absent : le rate-limiter vit en mémoire par process, et le push SSE ne
# franchit pas les process (le fan-out reste local — exact avec UN worker).
# Définir dès que plusieurs workers/instances tournent : `kojo_settings` refuse
# de démarrer en production avec WEB_CONCURRENCY > 1 sans REDIS_URL.
REDIS_URL=
# Canal du bus temps réel (défaut : kojo:live). À changer seulement si plusieurs
# produits partagent le même Redis : tous les process de CE produit doivent
# lire le même canal.
KOJO_LIVE_BUS_CHANNEL=
# Taille du tampon de publication (défaut : 1000). Au-delà, l'événement reste
# LOCAL et le bus le perd — la perte est comptée dans `bus_stats()['perdus']`.
# Doit encaisser la rafale d'une fenêtre de reconnexion (sonde Fly :
# ≥ MAX_STREAMS_TOTAL × délai de reprise, à une notification/s par flux).
KOJO_LIVE_BUS_QUEUE=
# Délai de reprise du bus après un échec (défaut : 2 s). Borné par la sonde Fly :
# au moins 1 s (sinon la boucle republie sans répit) et au plus un battement de
# cœur (au-delà, un Redis revenu n'est pas rejoint avant plusieurs battements,
# et le pub/sub ne rejoue rien).
KOJO_LIVE_BUS_RECONNECT_SECONDS=

# --- Google Sign-In (SSO, optionnel) ---
# Activer le SSO Google en remplissant les 3 variables. Sans elles,
# GOOGLE_AUTH_ENABLED=false et le bouton Google est masqué côté frontend.
# Créer un projet OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
# avec le client_id frontend (Web) et le client_secret backend (OAuth).
# GOOGLE_CLIENT_ID est aussi injecté côté frontend via VITE_GOOGLE_CLIENT_ID
# (ou window.__KOJO_GOOGLE_CLIENT_ID__ en override runtime).
# GOOGLE_REDIRECT_URI : pour le flux serveur classique, l'URI de callback
# déclarée dans la console Google (ex: https://api.kojo.app/auth/google/callback).
# Avec le flux popup + PKCE (défaut du frontend), le code est échangé côté
# backend sans redirect_uri de navigateur — la valeur peut rester vide.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Assistant IA (endpoint compatible OpenAI, OPTIONNEL) ---
# L'assistant de /support répond via un endpoint compatible OpenAI : un seul
# credential pour tous les modèles, sans clé de fournisseur côté Kojo. Le nom
# des variables dit « NEON » pour une raison historique ; le module
# (backend/kojo_ai_gateway.py) ne connaît que `/v1/chat/completions`. Sans ces
# variables, la fonctionnalité est DÉSACTIVÉE : la route
# /api/support/robot/chat répond 503 et la page retombe sur le questionnaire de
# demande de support. Le backend démarre donc sans elles.
#
# NEON_AI_GATEWAY_BASE_URL : hôte SANS chemin (le module ajoute
#   `/v1/chat/completions`). Deux hôtes exercés :
#     https://ep-xxxx-api.ai.aws-eu-central-1.aws.neon.tech  (AI Gateway Neon —
#       refusé en 403 sur un plan gratuit, l'inférence y est payante)
#     https://openrouter.ai/api  (OpenRouter — palier gratuit sans carte,
#       modèles `:free` ; en service depuis le 23/10/2026)
# NEON_AI_GATEWAY_TOKEN : jeton du fournisseur choisi (`nt_live_…` chez Neon,
#   `sk-or-v1-…` chez OpenRouter). SECRET — il ne quitte jamais le serveur : le
#   navigateur n'appelle que /api/support/robot/chat.
# NEON_AI_GATEWAY_MODEL : identifiant de catalogue chez le fournisseur choisi
#   (défaut `claude-haiku-4-5`, valeur du gateway Neon ; OpenRouter attend par
#   exemple `recursive/flint-v1.0:free`). Changer de fournisseur = changer
#   cette seule ligne ET l'hôte.
# NEON_AI_GATEWAY_TIMEOUT_SECONDS : borne d'un appel modèle (défaut 30 s).
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_AI_GATEWAY_MODEL=claude-haiku-4-5
NEON_AI_GATEWAY_TIMEOUT_SECONDS=30

# Budget de l'assistant : le plafond de DÉPENSE (backend/kojo_ai_budget.py).
# La limite de débit (20 POST / 5 min / IP) borne le débit, pas la facture ; ces
# deux compteurs sont GLOBAUX, par jour UTC, et partagés par les process (ils
# vivent dans la collection `ai_usage`, donc survivent à un redémarrage).
# Un plafond atteint répond 429 + Retry-After (prochain jour UTC) ; un compteur
# INJOIGNABLE répond 503 — dans les deux cas le formulaire de support reste le
# chemin garanti. Défauts : 200 appels et 250 000 caractères de prompt.
# Le FOURNISSEUR peut plafonner bien plus bas que ce budget : OpenRouter
# n'accorde que 50 requêtes par jour sur les modèles `:free` (mesuré le
# 23/10/2026, champ `free_model_daily_requests` de `GET /api/v1/key`). Garder
# ce budget SOUS ce plafond transforme le 429 du fournisseur (un 502 pour le
# visiteur) en 429 nommé du produit — d'où 45 en production.
NEON_AI_GATEWAY_DAILY_CALLS=200
NEON_AI_GATEWAY_DAILY_PROMPT_CHARS=250000

# Combien de temps le compteur d'une journée reste en base (aucune donnée
# personnelle : deux nombres et une date). Publié par PRIVACY.md.
AI_USAGE_RETENTION_DAYS=90

# --- Alerte d'arbitrage (litiges tranchés SANS réponse) ---
# Le propriétaire est prévenu quand la part des litiges TRANCHÉS sans qu'aucune
# réponse de l'autre partie n'existe dépasse ce seuil, sur une fenêtre
# glissante. Une alerte par dépassement : le retour sous le seuil réarme ;
# changer le seuil ou la fenêtre est un dépassement NEUF (ce qui est mesuré a
# changé). Sous 10 décisions dans la fenêtre, aucun taux n'est publié et aucune
# alerte ne part — « trop peu de litiges » n'est pas un verdict. Le seuil est
# une PART (0..1), pas un pourcentage. Défauts : 0.5, 90 jours, jugement
# quotidien (minutes).
LITIGE_SANS_REPONSE_SEUIL=0.5
LITIGE_SANS_REPONSE_FENETRE_JOURS=90
LITIGE_ALERTE_INTERVAL_MINUTES=1440

# --- Alerte « place de marché VIDE » (kojo_scheduler) ---
# Le propriétaire est prévenu quand AUCUNE mission ouverte n'existe en base
# depuis cette durée CONTINUE (heures). Un creux entre deux missions n'est pas
# une panne : l'alerte part une fois par épisode, et le RETOUR d'une mission
# ouverte la réarme. Le chronomètre vit en base (un redémarrage ne le remet pas
# à zéro). 1..720 ; taire l'alerte sur une instance pré-lancement se fait en
# réglant une durée longue, pas en la mettant à zéro.
MARCHE_VIDE_ALERTE_HEURES=24
# Cadence du jugement, en minutes (1..1440).
MARCHE_VIDE_ALERTE_INTERVALLE_MINUTES=60

# --- Alerte « missions ouvertes SANS AUCUNE proposition » (kojo_scheduler) ---
# L'offre est là et personne ne postule. Le propriétaire est prévenu quand des
# missions ouvertes attendent depuis plus de N jours SANS une seule candidature
# (tous statuts : une candidature refusée reste une candidature). Une alerte par
# CROISSANCE de la file : le même nombre ne se répète pas, une mission de plus
# qui vieillit rouvre l'alerte. 1..90 jours ; cadence en minutes (1..1440).
MISSIONS_SANS_PROPOSITION_JOURS=3
MISSIONS_SANS_PROPOSITION_INTERVALLE_MINUTES=360

# --- Support WhatsApp (Kapso) ---
# Le support reçoit aussi les messages WhatsApp. Kapso (kapso.ai) relaie l'API
# WhatsApp Business : le webhook arrive sur /api/support/whatsapp/webhook, signé
# en HMAC-SHA256 du corps brut (en-tête X-Webhook-Signature), et la réponse part
# en POST {base}/{version}/{phone_number_id}/messages avec la clé en X-API-Key.
# Tout le contrat est dans backend/kojo_whatsapp.py.
#
# Les quatre variables sont OPTIONNELLES et leur absence ne casse pas le boot :
#   • sans KAPSO_WEBHOOK_SECRET, la route répond 503 — l'ingestion est
#     DÉSACTIVÉE, jamais permissive (même posture que le webhook email) ;
#   • sans KAPSO_API_KEY ou KAPSO_PHONE_NUMBER_ID, un message reçu est enregistré
#     et ESCALADÉ en ticket au lieu d'être acquitté : on ne laisse pas croire au
#     client qu'on lui a répondu. Aucune des deux ne part dans le dépôt.
KAPSO_API_KEY=
# Identifiant du numéro émetteur (Kapso → Phone numbers).
KAPSO_PHONE_NUMBER_ID=
# Signing secret du webhook (Kapso → Webhooks). Un secret absent = 503 nommé.
KAPSO_WEBHOOK_SECRET=
# Dialecte Meta et délai d'envoi : à ne changer que pour épingler une version ou
# pointer une pile de test locale.
KAPSO_API_BASE_URL=https://api.kapso.ai/meta/whatsapp
KAPSO_API_VERSION=v24.0
KAPSO_TIMEOUT_SECONDS=10

# Combien de tours précédents de la conversation sont redonnés au modèle (chaque
# tour est facturé : kojo_ai_budget). 0 = aucune mémoire.
WHATSAPP_CONTEXT_MESSAGES=6
# Durée de conservation d'une conversation WhatsApp, publiée par PRIVACY.md.
WHATSAPP_MESSAGE_RETENTION_DAYS=90
